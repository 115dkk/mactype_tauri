{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "preview-studio",
  "description": "Capability set for the Preview Studio window",
  "windows": ["preview-studio"],
  "permissions": [
    "core:default",
    "core:event:default",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-start-dragging",
    "core:window:allow-toggle-maximize",
    "dialog:allow-open",
    "dialog:allow-save"
  ]
}
